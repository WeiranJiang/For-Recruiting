# Claude (drafting, people research, proofreading, rules chat) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=

# Google OAuth client (Gmail send + read) — see README "Google setup"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string (openssl rand -hex 32). Signs sessions and encrypts tokens/API keys.
SESSION_SECRET=
# Any long random string. Protects /api/cron.
CRON_SECRET=

# Postgres connection string (Neon via Vercel Storage sets this automatically).
# Leave empty locally to use an embedded database in ./.data
DATABASE_URL=

# Public URL of the app. Optional on Vercel (auto-detected). Locally: http://localhost:3000
APP_URL=

# Optional server-wide fallbacks for email lookup (users can also add their own keys in Setup)
# HUNTER_API_KEY=
# APOLLO_API_KEY=

# Local only: enables /api/auth/dev-login?seed=1 (demo user + sample drafts, no Google needed)
# DEV_LOGIN=1
